    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
